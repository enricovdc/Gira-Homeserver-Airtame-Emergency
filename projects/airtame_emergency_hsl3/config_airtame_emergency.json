          { "label": "API-Schlüssel" },
          { "label": "Alarm-ID-Präfix" },
          { "label": "HTTP-Timeout (s)" },
          { "label": "Max. Wiederholungen" },
          { "label": "Entprellung (ms)" },
          { "label": "Payload-Format (json / cap)" },
          { "label": "Sender-ID (CAP)" },
          { "label": "CAP-Kategorie" },
          { "label": "Test jetzt (sicher, kein Notruf)" }
