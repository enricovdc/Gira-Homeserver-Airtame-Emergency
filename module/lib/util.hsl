// module/lib/util.hsl
// Shared helpers: JSON-string escaping, base64, ISO 8601 timestamps,
// secret masking, and debounced rising-edge detection.
//
// HSL note: HSL is C-like. The functions below avoid any external libraries
// beyond what Gira HS 4.x exposes (string ops, system.time, system.base64).

// Escape a string for safe inclusion inside a JSON string literal.
// Mirrors Python's json.dumps for the subset of characters required by the
// Airtame payload (BMP only, no surrogate handling needed for typical alert text).
function string json_escape(string s) {
    string out = "";
    int i = 0;
    int n = strlen(s);
    while (i < n) {
        string c = substr(s, i, 1);
        if (c == "\"")      { out = out + "\\\""; }
        else if (c == "\\") { out = out + "\\\\"; }
        else if (c == "\n") { out = out + "\\n"; }
        else if (c == "\r") { out = out + "\\r"; }
        else if (c == "\t") { out = out + "\\t"; }
        else if (c == "\b") { out = out + "\\b"; }
        else if (c == "\f") { out = out + "\\f"; }
        else                { out = out + c; }
        i = i + 1;
    }
    return out;
}

// Format a UNIX-epoch second value as ISO 8601 with +00:00 offset.
function string iso8601_utc(int epoch_seconds) {
    // system.strftime is the HS-provided formatter; format ends with the
    // literal "+00:00" to match Airtame's accepted ISO 8601 form.
    return system.strftime("%Y-%m-%dT%H:%M:%S+00:00", epoch_seconds);
}

// Mask an API key for logging - keep first/last 2 chars only.
function string mask_secret(string secret) {
    int n = strlen(secret);
    if (n == 0) { return ""; }
    if (n <= 4) {
        string r = "";
        int i = 0;
        while (i < n) { r = r + "*"; i = i + 1; }
        return r;
    }
    return substr(secret, 0, 2) + "****" + substr(secret, n - 2, 2);
}

// Edge-debounced rising-edge detector. State is held in persistent module
// variables since HSL does not have closures in the Python sense.
//
// Caller pattern (per input pin):
//   if (edge_rising(pin_value, "trigger", debounce_ms)) { fire(); }
function bool edge_rising(bool value, string state_key, int debounce_ms) {
    string prev_key = "edge_prev_" + state_key;
    string last_key = "edge_last_" + state_key;
    int now_ms = system.gettime_ms();
    int prev   = system.getval(prev_key, 0);
    int last   = system.getval(last_key, -1000000000);
    bool rose  = (value && prev == 0);
    system.setval(prev_key, value ? 1 : 0);
    if (rose && (now_ms - last) >= debounce_ms) {
        system.setval(last_key, now_ms);
        return true;
    }
    return false;
}

// Structured log line. Secrets must already be masked by the caller.
function void log_info(string scope, string msg) {
    system.trace("[airtame] " + scope + ": " + msg);
}

function void log_error(string scope, string msg) {
    system.trace("[airtame][ERROR] " + scope + ": " + msg);
}
